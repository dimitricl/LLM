{
  "run_name": "sft_v8",
  "output_dir": "runs",
  "model": {
    "vocab_size": 24576,
    "d_model": 512,
    "n_layers": 12,
    "n_heads": 8,
    "n_kv_heads": 2,
    "ffn_hidden": 1408,
    "context_len": 512,
    "rope_theta": 10000.0,
    "rms_norm_eps": 1e-05
  },
  "train": {
    "micro_batch": 4,
    "grad_accum": 8,
    "lr": 2e-05,
    "min_lr_ratio": 0.1,
    "warmup_ratio": 0.03,
    "weight_decay": 0.01,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "max_steps": 6000,
    "eval_interval": 100,
    "checkpoint_interval": 500,
    "log_interval": 10,
    "sample_interval": 1000,
    "max_hours": 48.0,
    "seed": 42,
    "dtype": "bfloat16"
  },
  "data": {
    "tokenizer_path": "data/v8/tokenizer.json",
    "train_bin": "data/sft/packed_v8/train.tokens.bin",
    "val_bin": "data/sft/packed_v8/val.tokens.bin",
    "test_bin": "data/sft/packed_v8/test.tokens.bin",
    "sources": {
      "sft_v8": 1.0
    },
    "val_frac": 0.015,
    "test_frac": 0.015,
    "min_chars": 1,
    "max_chars": 100000
  }
}
