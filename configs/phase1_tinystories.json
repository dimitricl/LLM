{
  "run_name": "phase1_tinystories",
  "output_dir": "runs",
  "model": {
    "vocab_size": 16384,
    "d_model": 512,
    "n_layers": 12,
    "n_heads": 8,
    "n_kv_heads": 2,
    "ffn_hidden": 1408,
    "context_len": 512
  },
  "train": {
    "micro_batch": 16,
    "grad_accum": 8,
    "lr": 0.0006,
    "max_steps": 7629,
    "eval_interval": 500,
    "checkpoint_interval": 500,
    "log_interval": 10,
    "sample_interval": 1000,
    "max_hours": 48,
    "dtype": "bfloat16"
  },
  "data": {
    "tokenizer_path": "data/tokenizer.json",
    "train_bin": "data/phase1/train.bin",
    "val_bin": "data/phase1/val.bin",
    "test_bin": "data/phase1/test.bin",
    "sources": {"tinystories": 1.0},
    "val_frac": 0.01,
    "test_frac": 0.01
  }
}
